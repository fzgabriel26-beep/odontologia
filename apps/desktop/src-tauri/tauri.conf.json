{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odontologia",
  "version": "0.1.0",
  "identifier": "com.consultorio.odontologia",
  "build": {
    "beforeDevCommand": "node scripts/dev-web.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @odonto/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sistema de Gestión Odontológica",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:3001 https:; font-src 'self' data:; connect-src 'self' http://localhost:3001 https:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
