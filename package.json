{
  "name": "odontologia",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión odontológica (web + escritorio) sobre monorepo Turborepo/pnpm",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm generate && turbo build",
    "dev": "turbo dev",
    "generate": "prisma generate",
    "typecheck": "pnpm generate && turbo typecheck",
    "lint": "eslint .",
    "test": "pnpm generate && turbo test --filter=!@odonto/web && pnpm --filter @odonto/web test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prisma/adapter-pg": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
