# ------------------------------------------------------------------
# Copiar a .env en la raíz del monorepo y completar los valores.
# Nunca versionar archivos .env reales.
# ------------------------------------------------------------------

# --- API (NestJS) ---
API_PORT=3001
# Origen permitido del frontend (CORS / cookies). Lista separada por coma:
# el primero es el web (enlaces de recuperación), el del escritorio Tauri (fase 11).
WEB_ORIGIN=http://localhost:3000,http://tauri.localhost

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://odontologia:odontologia@localhost:5432/odontologia?schema=public

# --- Sesiones ---
# Duración de la sesión en minutos (expiración configurable).
SESSION_TTL_MIN=480
# Duración del token de recuperación de contraseña en minutos.
PASSWORD_RESET_TTL_MIN=30

# --- Rate limiting / fuerza bruta ---
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX=10
# Requests por minuto para el resto de la API (globales).
APP_RATE_LIMIT_MAX=120
# Orígenes extra permitidos para requests mutantes (CSRF, separados por coma).
CSRF_ORIGINS=

# --- Object Storage (S3 compatible) ---
# Proveedor: 'fs' (carpeta privada local, default sin Docker) o 's3' (bucket S3 compatible).
STORAGE_DRIVER=fs
# Solo STORAGE_DRIVER=fs: carpeta privada de binarios (relativa al cwd del API).
STORAGE_FS_DIR=storage-files
# Proveedor definitivo a definir en docs/ADR.md (fase 7: archivos).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=odontologia
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# --- Límites de archivos ---
MAX_UPLOAD_MB=25

# --- Seed / administrador inicial ---
SEED_ADMIN_EMAIL=admin@consultorio.local
# Contraseña inicial del administrador (cambiarla tras el primer inicio de sesión).
SEED_ADMIN_PASSWORD=Admin1234!

# --- Zona horaria ---
TZ=America/Argentina/Buenos_Aires

# --- Despliegue (ADR-016, p. ej. Render) ---
# Puerto inyectado por la plataforma (Render: PORT). En local manda API_PORT.
# PORT=10000
# Cookie cross-site: 'none' cuando el web y el API viven en dominios distintos
# (requiere HTTPS). En local se deja sin definir (SameSite=Lax, ADR-012).
# SESSION_COOKIE_SAMESITE=none
# Origen del web desplegado (primero de la lista → enlaces de recuperación):
# WEB_ORIGIN=https://mi-sitio.onrender.com

# --- Documentación Swagger (SDD §9, ADR-017) ---
# En dev siempre está servida en /api/v1/docs. En producción solo se monta si
# SWAGGER_ENABLED=true (por defecto la demo pública corre con docs apagadas).
# SWAGGER_ENABLED=true
